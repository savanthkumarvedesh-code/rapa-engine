# =============================================================================
# .gitignore
# =============================================================================

# SECRET FILES - NEVER commit these
.env
*.key
*.pem
secrets.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Database (generated at runtime - not source)
*.db
*.sqlite
*.sqlite3

# Logs / temp
*.log
*.tmp

# OS
.DS_Store
Thumbs.db
