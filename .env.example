# =============================================================================
# RAPA ENGINE - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is in .gitignore and MUST NOT be committed to version control.
# =============================================================================

# REQUIRED: Gemini API Key (used by processor.py for AI extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Gemini Model Override (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# OPTIONAL: IP Rotation via Proxy Pool
# Format: comma-separated proxy URLs
#   http://ip:port
#   http://ip:port:username:password
#   socks5://127.0.0.1:9050   (Tor local SOCKS5)
#
# When RAPA_PROXIES is set, ProxyRotator will health-check each proxy
# at startup (httpbin.org/ip), drop dead ones, and round-robin the rest.
#
# When RAPA_PROXIES is empty AND --use-proxies is passed, CLI exits loudly.
#
# Free rotating proxy services (prototype-grade):
#   - Webshare.io (10 free proxies/month)
#   - ProxyScrape.com (free tier)
#   - Tor local SOCKS5: socks5://127.0.0.1:9050
#
# Example:
# RAPA_PROXIES=http://185.199.228.220:7300,http://185.199.229.156:7300
# ---------------------------------------------------------------------------
RAPA_PROXIES=

# OPTIONAL: Scheduled daily extraction cron (default: 03:00 IST = 21:30 UTC)
# RAPA_SCHEDULE_CRON=30 21 * * *

# OPTIONAL: Database path override (default: data/rapa.db)
# RAPA_DB_PATH=data/rapa.db
